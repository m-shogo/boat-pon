{
  "name": "boat-pon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"tsx watch server/index.ts\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "preview": "vite preview",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -b",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "test": "node --test --import tsx --import ./scripts/test-tmpdir.mjs src/domain/*.test.ts src/research-replay/*.test.ts",
    "verify": "npm run typecheck && npm test && vite build",
    "db:init": "tsx scripts/init-db.ts",
    "db:health": "tsx scripts/check-db-health.ts",
    "backup": "tsx scripts/backup-db-safe.ts",
    "backup:safe": "tsx scripts/backup-db-safe.ts",
    "health": "tsx scripts/health-check.ts",
    "fetch:official-results": "tsx scripts/fetch-official-results.ts",
    "fetch:official-programs": "tsx scripts/fetch-official-programs.ts",
    "fetch:racer-stats": "tsx scripts/bulk-fetch-racer-stats.ts",
    "fetch:racer-stats:dry": "tsx scripts/bulk-fetch-racer-stats.ts --dry-run",
    "auto:odds": "tsx scripts/auto-fetch-odds.ts",
    "auto:beforeinfo": "tsx scripts/auto-fetch-exhibition.ts",
    "progress": "tsx scripts/live-progress.ts",
    "readiness": "tsx scripts/live-readiness.ts",
    "notify:line:daily": "tsx scripts/notify-line.ts daily",
    "notify:line:results": "tsx scripts/notify-line.ts results",
    "notify:line:weekly": "tsx scripts/notify-line.ts weekly",
    "notify:line:errors": "tsx scripts/notify-line.ts errors",
    "notify:line:test": "tsx scripts/notify-line.ts test",
    "report:accuracy-scorecard": "tsx scripts/report-accuracy-scorecard.ts",
    "report:growth": "tsx scripts/report-growth.ts",
    "audit:data-integrity": "tsx scripts/audit-data-integrity.ts",
    "reparse:official-results": "tsx scripts/reparse-official-results.ts",
    "review:t5-residual": "tsx scripts/review-20261007-t5-residual-extended.ts",
    "review:late-money": "tsx scripts/review-20261007-late-money.ts",
    "generate:vapid": "tsx scripts/generate-vapid-keys.ts",
    "export:odds-timeseries": "tsx scripts/export-odds-timeseries.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "cheerio": "1.2.0",
    "concurrently": "^9.2.1",
    "express": "^5.2.1",
    "lucide-react": "1.16.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
