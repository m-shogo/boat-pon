<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.boatpon.daily-programs</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/m-shogo/Developer/personal/boat-pon/scripts/daily-programs.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/m-shogo/Developer/personal/boat-pon</string>

  <!-- 毎朝 8:00 JST に番組表取得 -->
