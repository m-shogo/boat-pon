<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.boatpon.scorecard-publish</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/m-shogo/Developer/personal/boat-pon/scripts/publish-accuracy-scorecard.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/m-shogo/Developer/personal/boat-pon</string>

  <!-- 毎晩 22:15 JST に精度スコアカードの公開版を automation/scorecard へ置く（daily-results 21:30 のあと） -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>22</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/m-shogo/Developer/personal/boat-pon/data/logs/scorecard-publish.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/m-shogo/Developer/personal/boat-pon/data/logs/scorecard-publish-err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/m-shogo</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
