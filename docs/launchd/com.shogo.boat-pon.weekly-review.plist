<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.shogo.boat-pon.weekly-review</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>/Users/m-shogo/Developer/personal/boat-pon/scripts/run-weekly-rule-review.sh</string>
