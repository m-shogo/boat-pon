{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "research-task-request.schema.json",
  "title": "boat-pon one-shot research task request",
  "description": "ChatGPT Scheduled Task / operator が 1 回分だけ依頼する request。unknown field は拒否（strict）。1 request = 1 task。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestSchemaVersion", "requestId", "taskId", "requestedAction", "safetyLevel",
    "authoritySha", "queueDigest", "createdAt", "requestedBy", "maxDurationSeconds",
    "expectedOutput", "approvalRequirement", "requestDigest"
  ],
  "properties": {
    "requestSchemaVersion": { "const": "research-task-request-v1" },
    "requestId": { "type": "string", "pattern": "^REQ-[0-9A-Za-z._-]{4,64}$" },
    "taskId": { "type": "string", "pattern": "^(TASK-[0-9A-Za-z._-]{1,64}|NEXT)$" },
    "requestedAction": { "enum": ["run-task", "run-next", "status-only", "dry-run"] },
    "safetyLevel": { "enum": ["L0", "L1", "L2", "L3", "L4"] },
    "authoritySha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "queueDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "createdAt": { "type": "string", "minLength": 20 },
    "requestedBy": { "type": "string", "minLength": 1 },
    "maxDurationSeconds": { "type": "integer", "minimum": 60, "maximum": 21600 },
    "expectedOutput": { "type": "string", "minLength": 1 },
    "approvalRequirement": { "enum": ["none", "existing-grant-required"] },
    "approvalGrantId": { "type": "string", "minLength": 1 },
    "requestReference": { "type": "string", "minLength": 1 },
    "dryRun": { "type": "boolean" },
    "requestDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "safetyLevel": { "const": "L3" } } },
      "then": {
        "required": ["approvalGrantId"],
        "properties": { "approvalRequirement": { "const": "existing-grant-required" } }
      },
      "else": {
        "properties": { "approvalRequirement": { "const": "none" } }
      }
    }
  ]
}
