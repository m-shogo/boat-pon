{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boat-pon.local/schema/outcome-learning-ledger.0.1.json",
  "title": "Boat Pon Outcome Learning Ledger 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "outcomeRecordId", "decisionRecordId", "decisionId", "canonicalRaceId", "ticketType", "selection", "settlementId", "settledAt", "finality", "disposition", "evaluable", "stakeYen", "payoutYen", "refundYen", "refundReason", "popularity", "sourceEvidenceDigests", "provenanceVersion"],
  "properties": {
    "schemaVersion": { "const": "outcome-learning-ledger.0.1" },
    "outcomeRecordId": { "type": "string", "minLength": 1 },
    "decisionRecordId": { "type": "string", "minLength": 1 },
    "decisionId": { "type": "string", "minLength": 1 },
    "canonicalRaceId": { "type": "string", "minLength": 1 },
    "ticketType": { "type": "string", "minLength": 1 },
    "selection": { "type": "string", "minLength": 1 },
    "settlementId": { "type": "string", "minLength": 1 },
    "settledAt": { "type": "string", "format": "date-time" },
    "finality": { "enum": ["FINAL", "VOID"] },
    "disposition": { "enum": ["SETTLED", "REFUNDED", "VOID"] },
    "evaluable": { "type": "boolean" },
    "stakeYen": { "type": "integer", "minimum": 0 },
    "payoutYen": { "type": "integer", "minimum": 0 },
    "refundYen": { "type": "integer", "minimum": 0 },
    "refundReason": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "popularity": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
    "sourceEvidenceDigests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "provenanceVersion": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    { "if": { "properties": { "disposition": { "const": "SETTLED" } }, "required": ["disposition"] }, "then": { "properties": { "finality": { "const": "FINAL" }, "refundYen": { "const": 0 }, "refundReason": { "type": "null" } } } },
    { "if": { "properties": { "disposition": { "const": "REFUNDED" } }, "required": ["disposition"] }, "then": { "properties": { "finality": { "const": "FINAL" }, "refundYen": { "type": "integer", "minimum": 1 }, "refundReason": { "type": "string", "minLength": 1 }, "evaluable": { "const": false } } } },
    { "if": { "properties": { "disposition": { "const": "VOID" } }, "required": ["disposition"] }, "then": { "properties": { "finality": { "const": "VOID" }, "refundReason": { "type": "string", "minLength": 1 }, "evaluable": { "const": false } } } }
  ]
}
