{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "discovery.schema.json",
  "title": "Research Discovery",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "discoveryId",
    "sourceExperimentIds",
    "finding",
    "mechanismHypothesis",
    "evidenceLevel",
    "shareClass",
    "scope"
  ],
  "properties": {
    "discoveryId": {
      "type": "string",
      "pattern": "^DISC-[0-9A-Za-z._-]{1,80}$"
    },
    "sourceExperimentIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EXP-[0-9A-Za-z._-]{1,80}$"
      }
    },
    "finding": {
      "type": "string",
      "minLength": 1
    },
    "mechanismHypothesis": {
      "type": "string",
      "minLength": 1
    },
    "evidenceLevel": {
      "enum": [
        "weak",
        "moderate",
        "strong"
      ]
    },
    "shareClass": {
      "enum": [
        "GLOBAL_FACT",
        "RESEARCH_METHOD",
        "REUSABLE_CANDIDATE",
        "STRATEGY_LOCAL"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "adoptedBy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rejectedBy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
