{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boat-pon.local/schema/runtime-decision-ledger.0.1.json",
  "title": "Boat Pon Runtime Decision Ledger 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "decisionId",
    "canonicalRaceId",
    "sourceDecisionHistoryId",
    "decisionSystem",
    "strategyVersion",
    "modelVersion",
    "featureVersion",
    "manifestId",
    "cohortId",
    "evaluationMode",
    "ticketType",
    "selection",
    "decision",
    "decisionAt",
    "oddsObservedAt",
    "scheduledCloseAtSeen",
    "currentOdds",
    "requiredOdds",
    "estimatedHitRate",
    "rawEstimatedHitRate",
    "expectedValue",
    "recommendedStakeYen",
    "sampleSize",
    "reasons",
    "warnings",
    "dataCompleteness",
    "notificationEligible",
    "notificationDedupeKey",
    "sourceRowDigest"
  ],
  "$defs": {
    "exactInstant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000-)(?!.*-00:00$)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
    }
  },
  "properties": {
    "schemaVersion": { "const": "runtime-decision-ledger.0.1" },
    "recordId": { "type": "string", "minLength": 1 },
    "decisionId": { "type": "string", "minLength": 1 },
    "canonicalRaceId": { "type": "string", "minLength": 1 },
    "sourceDecisionHistoryId": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        { "type": "null" }
      ]
    },
    "decisionSystem": { "type": "string", "minLength": 1 },
    "strategyVersion": { "type": "string", "minLength": 1 },
    "modelVersion": { "type": "string", "minLength": 1 },
    "featureVersion": { "type": "string", "minLength": 1 },
    "manifestId": { "type": "string", "minLength": 1 },
    "cohortId": { "type": "string", "minLength": 1 },
    "evaluationMode": {
      "enum": ["formal_forward", "shadow_forward", "historical", "validation", "future_only"]
    },
    "ticketType": { "type": "string", "minLength": 1 },
    "selection": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["BUY", "WATCH", "SKIP"] },
    "decisionAt": { "$ref": "#/$defs/exactInstant" },
    "oddsObservedAt": {
      "oneOf": [
        { "$ref": "#/$defs/exactInstant" },
        { "type": "null" }
      ]
    },
    "scheduledCloseAtSeen": { "$ref": "#/$defs/exactInstant" },
    "currentOdds": {
      "oneOf": [
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "null" }
      ]
    },
    "requiredOdds": {
      "oneOf": [
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "null" }
      ]
    },
    "estimatedHitRate": {
      "oneOf": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "null" }
      ]
    },
    "rawEstimatedHitRate": {
      "oneOf": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "null" }
      ]
    },
    "expectedValue": {
      "oneOf": [
        { "type": "number" },
        { "type": "null" }
      ]
    },
    "recommendedStakeYen": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "sampleSize": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "dataCompleteness": { "enum": ["complete", "partial", "blocked"] },
    "notificationEligible": { "type": "boolean" },
    "notificationDedupeKey": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "sourceRowDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "decision": { "const": "BUY" } },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "dataCompleteness": { "const": "complete" },
          "currentOdds": { "type": "number", "exclusiveMinimum": 0 },
          "requiredOdds": { "type": "number", "exclusiveMinimum": 0 },
          "estimatedHitRate": { "type": "number", "minimum": 0, "maximum": 1 },
          "expectedValue": { "type": "number" },
          "recommendedStakeYen": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "oddsObservedAt": { "$ref": "#/$defs/exactInstant" }
        }
      }
    },
    {
      "if": {
        "properties": { "notificationEligible": { "const": true } },
        "required": ["notificationEligible"]
      },
      "then": {
        "properties": {
          "decision": { "const": "BUY" },
          "notificationDedupeKey": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
