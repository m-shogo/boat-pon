{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forward-evaluation-vault.0.1",
  "title": "Forward Evaluation Vault record",
  "type": "object",
  "unevaluatedProperties": false,
  "required": ["schemaVersion", "kind", "recordId", "evidenceStage", "createdAt"],
  "properties": {
    "schemaVersion": {"const": "forward-evaluation-vault.0.1"},
    "kind": {"enum": ["ENROLLMENT_PROTOCOL", "MEMBERSHIP", "ANALYSIS_SNAPSHOT", "EVALUATION_PROTOCOL", "RESULT"]},
    "recordId": {"type": "string", "minLength": 1, "pattern": "[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"},
    "evidenceStage": {"enum": ["HISTORICAL", "VALIDATION", "UNTOUCHED_HOLDOUT", "SHADOW_FORWARD", "FUTURE_ONLY"]},
    "createdAt": {"$ref": "#/$defs/exactInstant"}
  },
  "allOf": [
    {"if":{"properties":{"kind":{"const":"ENROLLMENT_PROTOCOL"}}},"then":{"required":["enrollmentProtocolId","decisionSystem","eligibilityRules","startAt","endAt","ticketUniverse","protocolVersion"],"properties":{"enrollmentProtocolId":{"type":"string","minLength":1,"pattern":"[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"},"decisionSystem":{"type":"string","minLength":1,"pattern":"[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"},"eligibilityRules":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"pattern":"[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"}},"startAt":{"$ref":"#/$defs/exactInstant"},"endAt":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/exactInstant"}]},"ticketUniverse":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"pattern":"[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"}},"protocolVersion":{"type":"string","minLength":1,"pattern":"[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"}}}},
    {"if":{"properties":{"kind":{"const":"MEMBERSHIP"}}},"then":{"required":["cohortId","enrollmentProtocolId","enrollmentProtocolDigest","canonicalRaceId","decisionRecordId","decisionRecordDigest","enrolledAt","included","reason"],"properties":{"cohortId":{"type":"string","minLength":1,"pattern":"[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"},"enrollmentProtocolId":{"type":"string","minLength":1,"pattern":"[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"},"enrollmentProtocolDigest":{"$ref":"#/$defs/digest"},"canonicalRaceId":{"type":"string","minLength":1,"pattern":"[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"},"decisionRecordId":{"type":"string","minLength":1,"pattern":"[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"},"decisionRecordDigest":{"$ref":"#/$defs/digest"},"enrolledAt":{"$ref":"#/$defs/exactInstant"},"included":{"type":"boolean"},"reason":{"type":"string","minLength":1,"pattern":"[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"}}}},
    {"if":{"properties":{"kind":{"const":"ANALYSIS_SNAPSHOT"}}},"then":{"required":["analysisSnapshotId","cohortId","cutoffAt","membershipDigests"],"properties":{"analysisSnapshotId":{"type":"string","minLength":1,"pattern":"[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"},"cohortId":{"type":"string","minLength":1,"pattern":"[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"},"cutoffAt":{"$ref":"#/$defs/exactInstant"},"membershipDigests":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/digest"}}}}},
    {"if":{"properties":{"kind":{"const":"EVALUATION_PROTOCOL"}}},"then":{"required":["evaluationProtocolId","comparisonMode","oddsBasis","metricFamilies","unresolvedPolicy","benchmarkDecisionSystems","protocolVersion"],"properties":{"evaluationProtocolId":{"type":"string","minLength":1,"pattern":"[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"},"comparisonMode":{"enum":["SELECTED_RACE","COMMON_COHORT"]},"oddsBasis":{"enum":["BUY_TIME","CLOSING","NONE"]},"metricFamilies":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"pattern":"[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"}},"unresolvedPolicy":{"const":"EXCLUDE_AND_COUNT"},"benchmarkDecisionSystems":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"pattern":"[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"}},"protocolVersion":{"type":"string","minLength":1,"pattern":"[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"}}}},
    {"if":{"properties":{"kind":{"const":"RESULT"}}},"then":{"required":["resultId","analysisSnapshotId","analysisSnapshotDigest","evaluationProtocolId","evaluationProtocolDigest","decisionSystem","comparisonMode","oddsBasis","metricFamily","includedCount","excludedCount","metrics","sourceManifestDigest","evaluatorVersion"],"properties":{"resultId":{"type":"string","minLength":1,"pattern":"[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"},"analysisSnapshotId":{"type":"string","minLength":1,"pattern":"[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"},"analysisSnapshotDigest":{"$ref":"#/$defs/digest"},"evaluationProtocolId":{"type":"string","minLength":1,"pattern":"[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"},"evaluationProtocolDigest":{"$ref":"#/$defs/digest"},"decisionSystem":{"type":"string","minLength":1,"pattern":"[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"},"comparisonMode":{"enum":["SELECTED_RACE","COMMON_COHORT"]},"oddsBasis":{"enum":["BUY_TIME","CLOSING","NONE"]},"metricFamily":{"type":"string","minLength":1,"pattern":"[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"},"includedCount":{"type":"integer","minimum":0,"maximum":9007199254740991},"excludedCount":{"type":"integer","minimum":0,"maximum":9007199254740991},"metrics":{"type":"object","minProperties":1,"additionalProperties":{"type":"number"}},"sourceManifestDigest":{"$ref":"#/$defs/digest"},"evaluatorVersion":{"type":"string","minLength":1,"pattern":"[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"}}}}
  ],
  "$defs": {"exactInstant":{"type":"string","format":"date-time","pattern":"^(?!0000-)(?!.*-00:00$)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"},"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
