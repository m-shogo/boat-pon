{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "promotion.schema.json",
  "title": "Promotion",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "promotionId",
    "strategyId",
    "fromVersion",
    "toState",
    "transferExperimentIds",
    "evidenceDigests",
    "humanApproval",
    "productionConnection",
    "createdAt"
  ],
  "properties": {
    "promotionId": {
      "type": "string",
      "pattern": "^PROMO-[0-9A-Za-z._-]{1,80}$"
    },
    "strategyId": {
      "type": "string",
      "pattern": "^STRAT-[0-9A-Za-z._-]{1,80}$"
    },
    "fromVersion": {
      "type": "string",
      "minLength": 1
    },
    "toState": {
      "enum": [
        "candidate",
        "shadow",
        "challenger",
        "active_research",
        "rejected",
        "archived"
      ]
    },
    "transferExperimentIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^XFER-[0-9A-Za-z._-]{1,80}$"
      }
    },
    "evidenceDigests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "humanApproval": {
      "type": "object"
    },
    "productionConnection": {
      "const": false
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    }
  }
}
