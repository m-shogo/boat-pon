# Boat Pon environment example
# Create .env in the repository root with real values.
# Do not commit .env.

# LINE Messaging API channel access token
BOAT_PON_LINE_CHANNEL_ACCESS_TOKEN=

# Comma-separated LINE recipient IDs: userId, groupId, or roomId
BOAT_PON_LINE_TO=

# Optional: print messages without sending to LINE
BOAT_PON_LINE_DRY_RUN=1

# Optional: override only for mock/test endpoints
# BOAT_PON_LINE_ENDPOINT=https://api.line.me/v2/bot/message/push
